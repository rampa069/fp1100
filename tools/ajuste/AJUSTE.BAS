10 REM CARTA DE AJUSTE FP-1100
20 REM C=COLOR  1-9=GROSOR  M=MODO
30 DIM N$(7):FOR J=1 TO 7:READ N$(J):NEXT J
40 C=7:G=1:M=0
50 GOSUB 200
60 K$=INKEY$:IF K$="" THEN 60
70 IF K$="C" OR K$=CHR$(99) THEN C=C+1:IF C>7 THEN C=1
80 IF K$>="1" AND K$<="9" THEN G=VAL(K$)
90 IF K$="M" OR K$=CHR$(109) THEN M=M+1:IF M>1 THEN M=0
100 GOSUB 200:GOTO 60
200 IF M=0 THEN WIDTH 80:X=639:M$="80 COL" ELSE WIDTH 40:X=319:M$="40 COL"
210 Y=199:COLOR C,0,C:CLS
220 PRINT:PRINT "   ";N$(C);"  ";M$;"  GROSOR";G
230 FOR I=0 TO G-1
240 DRAW(I,I)-(X-I,I)-(X-I,Y-I)-(I,Y-I)-(I,I)
250 NEXT I
260 DRAW(X/2,0)-(X/2,Y):DRAW(0,Y/2)-(X,Y/2)
270 RETURN
300 DATA AZUL,ROJO,MAGENTA,VERDE,CIAN,AMARILLO,BLANCO
